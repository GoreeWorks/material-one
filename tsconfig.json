{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@material-one/core": ["packages/core/src/index.ts"],
      "@material-one/components": ["packages/components/src/index.ts"],
      "@material-one/shell": ["packages/shell/src/index.ts"],
      "@material-one/themes": ["packages/themes/src/index.ts"],
      "@material-one/icons": ["packages/icons/src/index.ts"],
      "@material-one/controls": ["packages/controls/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts"
  ]
}
