  "typography": {
    "display": "3.5rem",
    "largeTitle": "2.5rem",
    "title": "2rem",
    "heading": "1.5rem",
    "body": "1rem",
    "label": "0.875rem",
    "supporting": "0.75rem",
    "sectionHeading": "1.5rem",
    "fontFamily": {
      "sans": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
      "mono": "SFMono-Regular, Consolas, Liberation Mono, monospace"
    },
    "weights": {
      "regular": 420,
      "medium": 560,
      "semibold": 640,
      "bold": 720
    },
    "lineHeight": {
      "display": 1.02,
      "largeTitle": 1.08,
      "title": 1.12,
      "sectionHeading": 1.2,
      "body": 1.5,
      "label": 1.3,
      "supporting": 1.4
    },
    "tracking": {
      "display": "-0.035em",
      "largeTitle": "-0.028em",
      "title": "-0.022em",
      "sectionHeading": "-0.015em",
      "body": "0em",
      "label": "0.01em",
      "supporting": "0.012em"
    },
    "maxLineLength": {
      "display": "18ch",
      "largeTitle": "24ch",
      "title": "28ch",
      "sectionHeading": "34ch",
      "body": "72ch",
      "label": "42ch",
      "supporting": "58ch"
    },
    "textScale": {
      "minimum": 0.8,
      "default": 1,
      "maximum": 2,
      "presets": {
        "small": 0.94,
        "large": 1.125,
        "extraLarge": 1.25
      }
    },
    "adaptive": {
      "compactHeadingScale": 0.92,
      "expandedHeadingScale": 1,
      "workspaceHeadingScale": 1.06,
      "bodyPreservesBaseScale": true
    }
  },
  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2.5rem",
    "2xl": "4rem"
  },
  "shape": {
    "extraSmall": "4px",
    "small": "8px",
    "medium": "14px",
    "large": "22px",
    "extraLarge": "32px",
    "pill": "999px"
  },
  "motion": {
    "instant": "90ms",
    "small": "160ms",
    "standard": "280ms",
    "large": "460ms",
    "skeleton": "1400ms",
    "easingStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "easingEmphasized": "cubic-bezier(0.2, 0, 0, 1.2)",
    "feedback": "160ms",
    "enter": "220ms",
    "exit": "160ms",
    "navigation": "280ms",
    "transform": "460ms",
    "emphasis": "360ms",
    "loading": "1400ms",
    "easingExit": "cubic-bezier(0.4, 0, 1, 1)",
    "distance": {
      "small": "4px",
      "medium": "8px",
      "large": "16px"
    },
    "intents": [
      "instant",
      "feedback",
      "enter",
      "exit",
      "navigation",
      "transform",
      "emphasis",
      "loading"
    ],
    "reducedMotion": {
      "decorativeDuration": "0ms",
      "essentialFeedbackMaximum": "100ms",
      "removesSpatialTranslation": true,
      "removesScaleEmphasis": true,
      "preservesStateCommunication": true
    },
    "none": {
      "duration": "0ms",
      "transitions": false,
      "animations": false
    }
  },
  "interaction": {
    "targetCompact": "36px",
    "targetComfortable": "44px",
    "targetTouch": "48px",
    "focusRing": "3px"
  },
  "loading": {
    "skeletonDelay": "180ms",
    "skeletonMinimumVisible": "300ms",
    "preserveLayout": true,
    "reducedMotionMode": "static"
  },
  "elevation": {
    "level0": "none",
    "level1": "0 1px 2px rgba(20, 20, 30, 0.08)",
    "level2": "0 4px 12px rgba(20, 20, 30, 0.10)",
    "level3": "0 12px 32px rgba(20, 20, 30, 0.14)"
  },
  "themeIntelligence": {
    "minimumTextContrast": 4.5,
    "schemes": [
      "light",
      "dark"
    ],
    "contrastModes": [
      "standard",
      "high"
    ],
    "preserveSemanticStatusMeaning": true,
    "userAccentMayOverride": [
      "primary",
      "secondary",
      "tertiary"
    ],
    "userAccentMustNotRedefine": [
      "success",
      "warning",
      "error",
      "information",
      "disabled"
    ],
    "highContrast": {
      "mutedContentUsesPrimaryContent": true,
      "outlineUsesStrongOutline": true,
      "strongerStateOverlays": true
    }
  },
  "visualization": {
    "categoricalPaletteSource": "color.coding",
    "semanticStatusSource": "color.semantic",
    "patterns": [
      "solid",
      "stripe",
      "dot",
      "crosshatch"
    ],
    "nonColorCueRequired": true,
    "axisRole": "outlineStrong",
    "gridRole": "outline",
    "labelRole": "onSurfaceMuted",
    "tooltipSurfaceRole": "surfaceInverse",
    "tooltipContentRole": "onSurfaceInverse",
    "focusRole": "focus",
    "positiveRole": "success",
    "negativeRole": "error",
    "cautionRole": "warning",
    "informationRole": "information",
    "selectedStateUsesFocusRing": true,
    "reducedMotionDisablesTransitions": true,
    "forcedColorsUsesSystemColors": true
  }
}
